{
  "name": "lumen",
  "productName": "Lumen",
  "version": "1.0.0",
  "description": "Offline self-growth desktop app: book summaries, brain training, speaking practice, habits and progress tracking.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.lumen.desktop",
    "productName": "Lumen",
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.education" },
    "linux": { "target": "AppImage", "category": "Education" }
  }
}
